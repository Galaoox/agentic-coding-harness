"""Read-only entrypoint for the Verifier's existing uv/pytest allowlist."""
from pathlib import Path
import subprocess
import sys


def test_authorization_acceptance():
    root = Path(__file__).resolve().parent
    result = subprocess.run([sys.executable, "-B", "check_outcome.py", "high-risk"],
                            cwd=root, capture_output=True, text=True, timeout=15)
    assert result.returncode == 0, result.stdout + result.stderr
